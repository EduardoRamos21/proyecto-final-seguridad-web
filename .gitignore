# =============================================================
# .gitignore - Archivos que NO deben subirse al repositorio
# =============================================================

# --- NOTA ACADÉMICA ---
# El .env SE INCLUYE en este repo SOLO porque es un proyecto de prueba escolar.
# En un proyecto real NUNCA se subiría el .env al repositorio.

# Base de datos y logs sí los ignoramos (se generan ejecutando npm run init-db)
backend/database.db
backend/database.db-shm
backend/database.db-wal
backend/logs/

# Certificados SSL (son locales)
backend/certs/

# --- Dependencias (se reinstalan con npm install) ---
node_modules/
backend/node_modules/
frontend/node_modules/

# --- Archivos de build (se generan con npm run build) ---
frontend/dist/

# --- Archivos del sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editores de código ---
.vscode/settings.json
*.swp
*.swo
