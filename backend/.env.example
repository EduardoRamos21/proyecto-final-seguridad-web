# =============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# =============================================================================
# IMPORTANTE: Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" real a GitHub (está en .gitignore).
# Solo sube este ".env.example" con los valores vacíos o de ejemplo.
# =============================================================================

# --- CONFIGURACIÓN DEL SERVIDOR ---
# Puerto donde escuchará el servidor
PORT=3001

# Entorno de ejecución: "development" muestra más detalles de errores
# En producción SIEMPRE debe ser "production" para ocultar stack traces
NODE_ENV=development

# --- SEGURIDAD: CLAVE SECRETA PARA JWT ---
# Esta clave se usa para FIRMAR los tokens JWT.
# Si alguien la roba, puede crear tokens falsos y hacerse pasar por cualquier usuario.
# Debe ser una cadena larga, aleatoria y completamente secreta.
# Puedes generarla con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CADENA_MUY_LARGA_Y_ALEATORIA_DE_AL_MENOS_64_CARACTERES

# Cuánto tiempo dura el token JWT antes de expirar (15 minutos es buena práctica)
# Opciones: "15m", "1h", "7d"
JWT_EXPIRES_IN=15m

# --- SEGURIDAD: CORS (Cross-Origin Resource Sharing) ---
# Solo permitimos peticiones desde esta URL del frontend.
# Esto evita que otros sitios web hagan peticiones a nuestra API.
FRONTEND_URL=http://localhost:5173

# --- BASE DE DATOS ---
# Ruta al archivo de base de datos SQLite
# Si el archivo no existe, se crea automáticamente
DB_PATH=./database.db

# --- BCRYPT ---
# Cuántas "vueltas" de encriptación aplicamos a las contraseñas.
# Más alto = más seguro pero más lento. 12 es un buen balance.
# No bajar de 10 en producción.
BCRYPT_SALT_ROUNDS=12

# --- HTTPS (Producción) ---
# Ruta al certificado TLS (usar mkcert para desarrollo local)
# SSL_CERT_PATH=./certs/localhost+1.pem
# SSL_KEY_PATH=./certs/localhost+1-key.pem
